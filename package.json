    "tailwindcss": "^4.2.1",
    "vue": "^3.5.18",
    "vue-i18n": "^9.2.2",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.2",
    "@types/pdfmake": "^0.3.3",
    "@vitejs/plugin-vue": "^6.0.1",

    "runner:smoke": "node scripts/smoke-code-runner.mjs",
    "test:markdown-render": "node scripts/test-markdown-render.mjs",
    "test:console-command": "node scripts/test-console-command.mjs",
    "test:console-state": "node scripts/test-console-state.mjs",
    "test:console-selection": "node scripts/test-console-selection.mjs",
    "test:console-timeline": "node scripts/test-console-timeline.mjs",
    "test:console-registry": "node scripts/test-console-registry.mjs",
    "test:console-suggestions": "node scripts/test-console-suggestions.mjs",
    "test:console-target": "node scripts/test-console-target.mjs",
    "test:console-display-mode": "node scripts/test-console-display-mode.mjs",
    "test:console-layout": "node scripts/test-console-layout.mjs",
    "test:console-route-parity": "node scripts/test-console-route-parity.mjs",
    "test:console-comment": "node scripts/test-console-comment.mjs",
    "test:console-avatar": "node scripts/test-console-avatar.mjs",
    "test:console-i18n": "node scripts/test-console-i18n.mjs",
    "test:heading-navigation": "node scripts/test-heading-navigation.mjs",
    "test:scroll-hash-navigation": "node scripts/test-scroll-hash-navigation.mjs",
    "test:color-scheme": "node scripts/test-color-scheme.mjs",
    "test:site-overview": "node scripts/test-site-overview.mjs",
    "test:infra-status": "node scripts/test-infra-status.mjs",
    "test:console": "pnpm test:console-command && pnpm test:console-state && pnpm test:console-selection && pnpm test:console-timeline && pnpm test:console-registry && pnpm test:console-suggestions && pnpm test:console-target && pnpm test:console-display-mode && pnpm test:console-comment && pnpm test:console-avatar && pnpm test:console-i18n && pnpm test:site-overview && pnpm test:console-layout && pnpm test:console-route-parity && pnpm test:heading-navigation && pnpm test:scroll-hash-navigation && pnpm test:color-scheme",
    "typecheck": "vue-tsc --noEmit",
    "build": "pnpm run content:sync && node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "runner:smoke:docs": "node scripts/smoke-sandkasten-doc.mjs"
